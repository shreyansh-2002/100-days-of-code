Question:- https://leetcode.com/problems/find-overbooked-employees/description/

Query:-

SELECT 
    e.employee_id,
    e.employee_name,
    e.department,
    COUNT(*) as meeting_heavy_weeks
FROM employees e
JOIN (
        SELECT 
            employee_id,
            YEARWEEK(meeting_date,1) as week_id
        FROM meetings
        GROUP BY employee_id, week_id
        HAVING SUM(duration_hours) > 20
     ) m
ON e.employee_id = m.employee_id
GROUP BY e.employee_id, e.employee_name, e.department
HAVING COUNT(*) >= 2
ORDER BY meeting_heavy_weeks DESC, employee_name ASC;